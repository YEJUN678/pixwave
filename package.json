{
  "name": "soundpack-site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "import:audio": "tsc -p scripts/tsconfig.verify.json && node .verify-build/scripts/import-audio.js",
    "verify": "tsc -p scripts/tsconfig.verify.json && node .verify-build/scripts/verify.js",
    "verify:rebuild": "npm run import:audio && npm run verify",
    "deploy": "tsc -p scripts/tsconfig.verify.json && node .verify-build/scripts/deploy.js"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
