# 정식 도메인 — canonical / sitemap / og:url 에 들어갑니다.
# GitHub Pages 로 먼저 배포할 때는 실제 주소를 여기에 넣으세요.
# (넣지 않으면 아직 없는 pixwave.io 를 가리킵니다)
# NEXT_PUBLIC_SITE_URL=https://YEJUN678.github.io
NEXT_PUBLIC_SITE_URL=https://pixwave.io

# 저장소형 페이지(YEJUN678.github.io/pixwave)로 옮길 때만 필요합니다.
# NEXT_PUBLIC_BASE_PATH=/pixwave

# clickmon 광고 계정 식별자
# 도메인(pixwave.io)을 바꾸거나 계정을 교체할 때 이 값만 바꾸면 됩니다.
# NEXT_PUBLIC_ 접두사가 붙으므로 빌드 시점에 인라인됩니다.
# 광고 코드는 이미 클릭몽 광고주 콘솔에서 받은 값이므로 기본값으로도 동작합니다.
NEXT_PUBLIC_CLICKMON_ACCOUNT=CM_M_1003067%7C%5E%7CCM_A_1157408%7C%5E%7CAdver_M_1046207

# 서버 배포(Vercel 등)할 때만 "server" 로 지정합니다.
# GitHub Pages 정적 export 가 기본입니다.
# DEPLOY_TARGET=server
